        {
            "parameters": {
                "url": "={{ $('الإعدادات').item.json.apiBase }}/api/attendance",
                "sendQuery": true,
                "queryParameters": {
                    "parameters": [
                        {
                            "name": "date",
                            "value": "={{ $now.setZone('Africa/Tripoli').toFormat('yyyy-MM-dd') }}"
                        }
                    ]
                },
